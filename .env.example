# Dashboard auth
ADMIN_PASSWORD=changeme
SESSION_SECRET=generate-a-random-32-char-string-here

# Supabase
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
# Comma-separated — one long-lived access token per account, order matches INSTAGRAM_ACCOUNT_IDS
INSTAGRAM_ACCESS_TOKENS=token1,token2,token3,token4,token5
INSTAGRAM_ACCOUNT_IDS=id1,id2,id3,id4,id5

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Comma-separated — one refresh token per channel, order matches YOUTUBE_CHANNEL_IDS
YOUTUBE_REFRESH_TOKENS=token1,token2,token3,token4,token5
YOUTUBE_CHANNEL_IDS=id1,id2,id3,id4,id5

# Anthropic
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
